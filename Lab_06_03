import java.util.Scanner;

public class Main{

    public static void main(String[] args) {
        java.util.Scanner input = new Scanner(System.in);
        double lengthOfRectangle;
        double widthOfRectangle;
        System.out.print("Enter in the Length of the Rectangle: ");
        if (input.hasNextDouble()) {
            lengthOfRectangle = input.nextDouble();
        } else {
            System.out.println("Invalid input: please enter in a numerical value");
            return;
        }
        System.out.print("Enter in the Width of the Rectangle: ");
        if (input.hasNextDouble()) {
            widthOfRectangle = input.nextDouble();
        } else {
            System.out.println("Invalid input: please enter in a numerical value");
            return;
        }
        if (lengthOfRectangle <= 0 || widthOfRectangle <= 0) {
            System.out.println("Error: The side lengths must be greater than 0");
            return;
        }
        double areaOfRectangle = lengthOfRectangle * widthOfRectangle;
        double perimeterOfRectangle = 2 * (lengthOfRectangle + widthOfRectangle);
        double diagonalOfRectangle = Math.sqrt((lengthOfRectangle * lengthOfRectangle) + (widthOfRectangle * widthOfRectangle));

        System.out.printf("The area of the Rectangle is : %5.2f%n", areaOfRectangle);
        System.out.println();
        System.out.printf("The perimeter of the Rectangle is: %5.2f%n", perimeterOfRectangle);
        System.out.println();
        System.out.printf("The diagonal of the Rectangle is: %5.2f%n", diagonalOfRectangle);
    }
}
